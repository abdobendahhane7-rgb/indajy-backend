generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  fullName       String
  phone          String         @unique
  email          String?        @unique
  passwordHash   String
  role           UserRole
  approvalStatus ApprovalStatus @default(PENDING)
  city           String?
  address        String?
  latitude       Float?
  longitude      Float?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  participantOne     ChatConversation[]  @relation("ConversationUserOne")
  participantTwo     ChatConversation[]  @relation("ConversationUserTwo")
  sentMessages       ChatMessage[]       @relation("MessageSender")
  favorites          Favorite[]
  listings           Listing[]           @relation("BreederListings")
  orders             Order[]             @relation("DistributorOrders")
  driverOrders       Order[]             @relation("DriverOrders")
  rechargeRequests   RechargeRequest[]
  documents          UserDocument[]
  wallet             Wallet?
  walletTransactions WalletTransaction[] @relation("WalletUserTransactions")

  farms Farm[]

  // =========================================================
  // POSTS CREATED BY ADMIN
  // =========================================================

  adminPosts Post[] @relation("AdminPosts")
}

model Farm {
  id        String   @id @default(cuid())
  name      String
  farmerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer   User      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@unique([farmerId, name])
  @@index([farmerId])
}

model UserDocument {
  id         String   @id @default(cuid())
  userId     String
  cinUrl     String?
  onssaUrl   String?
  legalUrl   String?
  driverUrl  String?
  vehicleUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Listing {
  id       String @id @default(cuid())
  farmerId String

  // Nullable bach listings l9dam maytksroch
  farmId String?

  title String

  category String @default("دجاج اللحم")
  variant  String @default("دجاج اللحم")

  description String?

  // Exemple: 38-40/100
  netWeight String?

  // Total stock dyal had lferma
  quantityKg Float

  // Stock li mazal disponible
  availableKg Float

  pricePerKg      Decimal @db.Decimal(12, 2)
  totalStockValue Decimal @db.Decimal(12, 2)

  city    String
  address String?

  latitude  Float
  longitude Float

  farmLink String?

  status       ListingStatus @default(ACTIVE)
  isGpsEnabled Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations ChatConversation[]
  favorites     Favorite[]

  farmer User  @relation("BreederListings", fields: [farmerId], references: [id], onDelete: Cascade)
  farm   Farm? @relation(fields: [farmId], references: [id], onDelete: SetNull)

  images ListingImage[]
  orders Order[]

  @@index([farmerId])
  @@index([farmId])
  @@index([city])
  @@index([status])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  imageUrl  String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Order {
  id              String      @id @default(cuid())
  listingId       String
  distributorId   String
  quantityKg      Float
  pricePerKg      Decimal     @db.Decimal(12, 2)
  subtotal        Decimal     @db.Decimal(12, 2)
  operationFee    Decimal     @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  deliveryAddress String?
  deliveryCity    String?
  deliveryLat     Float?
  deliveryLng     Float?
  note            String?
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  driverId        String?

  distributor User    @relation("DistributorOrders", fields: [distributorId], references: [id])
  driver      User?   @relation("DriverOrders", fields: [driverId], references: [id])
  listing     Listing @relation(fields: [listingId], references: [id])

  tracking OrderTracking[]

  @@index([listingId])
  @@index([distributorId])
  @@index([driverId])
  @@index([status])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id        String                  @id @default(cuid())
  walletId  String
  userId    String
  type      WalletTransactionType
  status    WalletTransactionStatus @default(PENDING)
  amount    Decimal                 @db.Decimal(12, 2)
  fee       Decimal                 @default(0) @db.Decimal(12, 2)
  netAmount Decimal                 @default(0) @db.Decimal(12, 2)
  note      String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  user   User   @relation("WalletUserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
}

model RechargeRequest {
  id         String                @id @default(cuid())
  userId     String
  amount     Decimal               @db.Decimal(12, 2)
  method     String
  receiptUrl String
  status     RechargeRequestStatus @default(PENDING)
  note       String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AppSetting {
  id             String   @id @default(cuid())
  operationFee   Decimal  @default(10) @db.Decimal(12, 2)
  rechargeFee    Decimal  @default(0) @db.Decimal(12, 2)
  minOrderKg     Float    @default(1)
  isOrderingOpen Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model ChatConversation {
  id            String    @id @default(cuid())
  userOneId     String
  userTwoId     String
  listingId     String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listing Listing? @relation(fields: [listingId], references: [id])

  userOne User @relation("ConversationUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo User @relation("ConversationUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@index([userOneId])
  @@index([userTwoId])
  @@index([listingId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model OrderTracking {
  id        String   @id @default(cuid())
  orderId   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  driverId  String?
  heading   Float?
  speed     Float?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([driverId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

// ===========================================================
// ADMIN POSTS
// ===========================================================

model Post {
  id String @id @default(cuid())

  // Admin li create had post
  authorId String

  // Text optional:
  // hit post y9der ykon image only
  text String?

  // Image optional:
  // hit post y9der ykon text only
  imageUrl String?

  // Chkon ychof post
  audience PostAudience @default(ALL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation("AdminPosts", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([audience])
  @@index([createdAt])
}

// ===========================================================
// ENUMS
// ===========================================================

enum UserRole {
  ADMIN
  FARMER
  DISTRIBUTOR
  DRIVER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  ACTIVE
  OUT_OF_STOCK
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  COMPLETED
  CANCELLED
  REJECTED
}

enum WalletTransactionType {
  CREDIT
  DEPOSIT
  ORDER_FEE
  REFUND
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RechargeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ===========================================================
// POST AUDIENCE
// ===========================================================

enum PostAudience {
  // المربين والموزعين بجوج
  ALL

  // غير المربين
  FARMER

  // غير الموزعين
  DISTRIBUTOR
}
